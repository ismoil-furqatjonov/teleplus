# ===================================================
# TelePulse - AI Features & Server Settings
# ===================================================

# Server Port & Host
PORT=8000
HOST=0.0.0.0

# ─── Google Gemini AI API Key ─────────────────────────────────────────────────
# Barcha AI funksiyalari uchun (Chat, Writer, Image Analysis, Translation va h.k.)
# https://aistudio.google.com/app/apikey dan oling
GEMINI_API_KEY=

# ─── Google Cloud Text-to-Speech ─────────────────────────────────────────────
# https://console.cloud.google.com/ dan yarating
# Agar bo'lmasa, Web Speech API ishlatiladi (bepul, lekin sifat pastroq)
GOOGLE_TTS_API_KEY=

# ─── AI Model Configuration ───────────────────────────────────────────────────
# gemini-2.0-flash-exp | gemini-1.5-flash | gemini-1.5-pro
AI_MODEL=gemini-2.0-flash-exp

# AI Chat tili: uz (O'zbek) | ru (Rus) | en (Ingliz)
AI_LANGUAGE=uz

# ─── Moderation Settings ──────────────────────────────────────────────────────
# Moderation Strictness: "relaxed" | "balanced" | "strict"
MODERATION_STRICTNESS=balanced

# ─── File Upload Limits ───────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=50

# ─── AI Feature Toggles (server-level defaults) ───────────────────────────────
AI_CHAT_ENABLED=true
AI_WRITER_ENABLED=true
AI_TTS_ENABLED=true
AI_VOICE_ENABLED=true
AI_IMAGE_ANALYSIS_ENABLED=true
AI_TRANSLATION_ENABLED=true
AI_SMART_REPLY_ENABLED=true
AI_SUMMARY_ENABLED=true

# ─── Audit & Logging ─────────────────────────────────────────────────────────
MAX_AUDIT_LOGS=500
